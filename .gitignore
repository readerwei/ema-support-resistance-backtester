# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments — uv rebuilds .venv from pyproject.toml + uv.lock, never commit it
.venv/
venv/
.env
.python-version

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Tool output written into the working directory by the CLI:
#   --output / --scan-output  -> CSV
#   --plot / --scan-plot      -> self-contained HTML
# Ignored so a research run never dirties the tree. Use `git add -f` if you
# ever do want to commit a small fixture.
*.csv
*.html

# Local calibration-study artifacts (provenance, raw p-values, run logs).
# Evidence for one specific run, not source. Keep them locally, don't commit them.
calibration_*.json
calibration_*.log
ema_sr_null_calibration_*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
